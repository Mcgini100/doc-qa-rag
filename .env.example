# Leave OPENAI_API_KEY empty to run fully offline (local embeddings + extractive answers).
OPENAI_API_KEY=
# auto | openai | local
EMBEDDING_BACKEND=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
TOP_K=5
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_INGEST=3/minute
# Required in the X-Admin-Token header for POST /ingest when set.
ADMIN_TOKEN=
